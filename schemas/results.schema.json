          "fixes": {
            "maxItems": 0
          },
          "voi": {
            "maxItems": 0
          },
          "residual": {
            "type": "null"
          },
          "fix_sets": {
            "properties": {
              "greedy": {
                "maxItems": 0
              },
              "exact": {
                "type": "null"
              },
              "robust": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "complete"
          }
        }
      },
      "then": {
        "properties": {
          "residual": {
            "type": "object"
          }
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SABLE results v1.0"
