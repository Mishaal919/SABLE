      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "breaks_edges": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "type": {
          "enum": [
            "chmod",
            "chown",
            "capability",
            "sudo",
            "service",
            "manual"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "rollback": {
          "type": "string",
          "minLength": 1
        },
        "execution": {
          "enum": [
            "script_and_apply",
            "recommend_only"
          ]
